# Copied to .env for local runs (gitignored); the real environment wins over
# the file. No variable carries a product prefix.

# Runtime (S1)
PORT=8080
HOST=0.0.0.0
# Database and other state; the database file name comes from product.json.
DATA_DIR=./data
# Overrides DATA_DIR/<dbFile> outright.
# DB_PATH=
# Reported by /healthz.
# GIT_SHA=

# Development identity bypass: signs every request in as an admin. Needs
# NODE_ENV other than "production"; the image sets production.
# DEV_AUTH=1

# Platform (S2) — same meanings as in code-console.
# PUBLIC_ORIGIN=https://cluster.example.test
# SECRETS_KEY=
# BOOTSTRAP_ADMIN_PASSWORD=
# Comma-separated usernames or emails, and groups, that are always admins.
# ADMIN_USERS=
# ADMIN_GROUPS=
# TRUSTED_PROXIES=
# CLIENT_IP_HEADER=
# DRAIN_MS=600000
